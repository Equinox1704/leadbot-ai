# Leadbot AI environment configuration
# Copy this file to .env.local for local development.
# Never commit real API keys, tokens, passwords, or service-role credentials.

# Use only if the frontend source actually reads these public Vite variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Do NOT put AI-provider credentials in a VITE_* variable.
# Set your AI-provider key as a Supabase Edge Function secret instead.
#
# First inspect supabase/functions/chat/index.ts to find the exact variable name
# your function expects. Example only:
# supabase secrets set AI_PROVIDER_API_KEY=replace-with-your-provider-key

# Optional future integration; do not use until webhook/CRM delivery is implemented.
LEAD_WEBHOOK_URL=https://example.com/webhooks/leadbot
